# clang-tidy configuration for SedSAT3 (used by the GitLab CI clang-tidy job).
# Third-party code under thirdparty/ is not analysed.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-member-init,
  clang-analyzer-*,
  concurrency-mt-unsafe,
  performance-unnecessary-value-param,
  performance-for-range-copy,
  -clang-analyzer-optin.*
WarningsAsErrors: 'cppcoreguidelines-init-variables,cppcoreguidelines-pro-type-member-init,concurrency-mt-unsafe'
HeaderFilterRegex: '^(?!.*thirdparty).*/(include|src|Utilities|cli)/.*|^(?!.*thirdparty)[^/]*\.h$'
CheckOptions:
  - key: cppcoreguidelines-init-variables.MathHeader
    value: '<cmath>'
